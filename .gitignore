.venv/
backend/__pycache__/
backend/app/__pycache__/
backend/app/routers/__pycache__/
**/__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/

frontend/node_modules/
# Build output. Release zips ship a pre-built dist/; a git checkout builds
# it locally with `npm run build`.
frontend/dist/
frontend/tsconfig.tsbuildinfo

# Runtime state (presets, llama-server log) from releases that kept it next
# to run.py. Newer versions store it in the per-user data dir instead, but
# an explicit data_dir may still point here.
/data/

# Ignore obsolete local configuration left over from older releases.
/config.ini
