# Normalize line endings: everything git detects as text is stored with LF
# and checked out with LF on every platform. Keeps release zips built on
# Linux runners byte-identical to local checkouts on Windows.
* text=auto eol=lf

# Windows-only files that must keep CRLF to run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries: never touch.
*.png binary
*.jpg binary
*.ico binary
*.gguf binary
*.woff binary
*.woff2 binary
*.zip binary
